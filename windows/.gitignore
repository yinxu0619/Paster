# Locally installed SDK and all build output.
.dotnet/
artifacts/
**/bin/
**/obj/

# Assets/ is deliberately tracked. The icons are generated by scripts/generate-icon.ps1, but they
# are also build inputs (<ApplicationIcon>) and the tray icon is loaded from Assets\Paster.ico at
# runtime, so committing them keeps a fresh clone building and running with the same branding.
