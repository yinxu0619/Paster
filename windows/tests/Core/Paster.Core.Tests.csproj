<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <Compile Include="../../src/Paster.Windows/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../src/Paster.Windows/Native/NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="../../src/Paster.Windows/Services/ClipboardDatabase.cs" Link="ClipboardDatabase.cs" />
    <Compile Include="../../src/Paster.Windows/Services/AppSettings.cs" Link="AppSettings.cs" />
  </ItemGroup>
</Project>
